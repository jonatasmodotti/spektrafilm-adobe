+  if (gid.x >= n * n || gid.y >= n) {
+    return;
+  }
+  const uint3 g = uint3(gid.x / n, gid.x % n, gid.y);
+  const float3 t = float3(g) / float(n - 1u);
+  const float3 filmMin = domain.filmMin.xyz;
+  const float3 filmMax = domain.filmMax.xyz;
+  const float3 printMin = domain.printMin.xyz;
+  const float3 printMax = domain.printMax.xyz;
