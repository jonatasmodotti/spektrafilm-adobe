+// Register-blocked vertical gaussian: one thread computes kSpektraBlurBlockY
+// consecutive rows and slides a window of samples through registers, so each offset
+// costs two loads for the whole block instead of two per output. The per-output
+// arithmetic and its order match spektra_channel_gaussian_sample_y; blocks that touch
+// the top or bottom edge use that function, so results are bit-identical.
+constant constexpr int kSpektraBlurBlockY = 4;
+
+static void spektra_channel_gaussian_block_y(
+  device const float4 *source,
+  uint width,
+  uint height,
+  uint2 blockStart,
+  float3 sigma,
+  thread float4 *out
+) {
+  const int start = int(blockStart.y);
+  const float maxSigma = spektra_max3(sigma);
+  const int radius = maxSigma <= 1.0e-4 ? 0 : min(int(ceil(3.0 * maxSigma)), 256);
+  if (maxSigma <= 1.0e-4 || start < radius || start + kSpektraBlurBlockY - 1 + radius >= int(height)) {
+    for (int k = 0; k < kSpektraBlurBlockY && start + k < int(height); ++k) {
+      out[k] = spektra_channel_gaussian_sample_y(source, width, height, uint2(blockStart.x, blockStart.y + uint(k)), sigma);
+    }
+    return;
+  }
+  device const float4 *base = source + blockStart.y * width + blockStart.x;
+  const float3 safeSigma = max(sigma, float3(1.0e-6));
+  const float3 invSigma2 = 1.0 / max(safeSigma * safeSigma, float3(1.0e-8));
+  float3 weight = exp(-0.5 * invSigma2);
+  float3 ratio = exp(-1.5 * invSigma2);
+  const float3 ratioStep = exp(-invSigma2);
+  float3 weightSum = float3(1.0);
+  float4 above[kSpektraBlurBlockY];
+  float4 below[kSpektraBlurBlockY];
+  for (int k = 0; k < kSpektraBlurBlockY; ++k) {
+    out[k] = base[uint(k) * width];
+    above[k] = out[k];
+    below[k] = out[k];
+  }
+  for (int offset = 1; offset <= radius; ++offset) {
+    // above[k] = row (start + k - offset), below[k] = row (start + k + offset).
+    for (int k = kSpektraBlurBlockY - 1; k > 0; --k) {
+      above[k] = above[k - 1];
+    }
+    above[0] = *(base - uint(offset) * width);
+    for (int k = 0; k < kSpektraBlurBlockY - 1; ++k) {
+      below[k] = below[k + 1];
+    }
+    below[kSpektraBlurBlockY - 1] = base[uint(kSpektraBlurBlockY - 1 + offset) * width];
+    for (int k = 0; k < kSpektraBlurBlockY; ++k) {
+      const float4 samplePair = above[k] + below[k];
+      out[k].rgb += samplePair.rgb * weight;
+      out[k].a += samplePair.a;
+    }
+    weightSum += 2.0 * weight;
+    weight *= ratio;
+    ratio *= ratioStep;
+  }
+  for (int k = 0; k < kSpektraBlurBlockY; ++k) {
+    out[k].rgb /= max(weightSum, float3(1.0e-8));
+    out[k].a /= float(radius * 2 + 1);
+  }
+}
