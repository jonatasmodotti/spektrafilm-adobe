+// Final LUT written straight into an Adobe host frame with the source alpha
+// (replaces final LUT + pack).
+kernel void spektrafilm_final_from_film_density_lut_adobe_host(
+  device const float4 *filmDensity [[buffer(0)]],
+  device uchar *destination [[buffer(1)]],
+  constant SpektraKernelParams &params [[buffer(2)]],
+  constant uint2 &dims [[buffer(3)]],
+  constant SpektraSpectralInfo &spectralInfo [[buffer(4)]],
+  constant SpektraColorInfo &colorInfo [[buffer(5)]],
+  device const uint *transferKinds [[buffer(6)]],
+  constant SpektraCurveInfo &paperCurveInfo [[buffer(7)]],
+  device const float *paperLogExposure [[buffer(8)]],
+  device const float *paperDensityCurves [[buffer(9)]],
+  device const float4 *filmSpectralDensity [[buffer(10)]],
+  device const float4 *filteredEnlargerResponse [[buffer(11)]],
+  device const float4 *paperSpectralDensity [[buffer(12)]],
+  device const float *scanProducts [[buffer(13)]],
+  device const float *scanToOutputRgbData [[buffer(14)]],
+  device const float *encodeLuts [[buffer(15)]],
+  constant SpektraFrameConstants &frameConstants [[buffer(16)]],
+  constant uint &encodeOutput [[buffer(17)]],
+  device const float4 *enlargerLut [[buffer(18)]],
+  device const float4 *scannerLut [[buffer(19)]],
+  device const uchar *hostSource [[buffer(20)]],
+  constant SpektraAdobeHostLayout &sourceLayout [[buffer(21)]],
+  constant SpektraAdobeHostLayout &destinationLayout [[buffer(22)]],
+  uint2 gid [[thread_position_in_grid]]
+) {
+  if (gid.x >= dims.x || gid.y >= dims.y) {
+    return;
+  }
+  const uint index = gid.y * dims.x + gid.x;
+  const float4 pixel = spektra_final_from_film_density_lut_pixel(filmDensity[index], params, spectralInfo, colorInfo, transferKinds, paperCurveInfo,
+    paperLogExposure, paperDensityCurves, filmSpectralDensity, filteredEnlargerResponse, paperSpectralDensity,
+    scanProducts, scanToOutputRgbData, encodeLuts, frameConstants, encodeOutput, enlargerLut, scannerLut);
+  spektra_adobe_host_store(destination, destinationLayout, gid,
+    float4(pixel.rgb, spektra_adobe_host_load(hostSource, sourceLayout, gid).a));
+}
