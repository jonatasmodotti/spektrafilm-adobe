+// Spectral 3D LUTs, as in spektrafilm's use_enlarger_lut/use_scanner_lut.
+// Both spectral integrals have the form sum_l w_l * 10^-(d . s_l), with w_l >= 0,
+// so their log is smooth and nearly linear in d. The LUTs store log2 of the
+// positive integral; every non-spectral step (timing, exposure, paper curve,
+// colour matrix, encoding) stays exact per pixel. Each LUT buffer starts with
+// two float4 headers: (domain minimum, size) and (cells per density unit, error
+// tolerance). Grid entry .w holds, for the cell whose lowest corner it is, the
+// output-space interpolation error measured at the cell centre. Saturated colours near a
+// dye's maximum density switch the dominant spectral band abruptly; cells whose
+// error exceeds the tolerance, inputs outside the domain, and non-finite inputs
+// use the exact integral instead.
+constant uint kSpektraLutHeader = 2u;
+
+static float3 spektra_lut_spectral_sum(
+  float3 densityCmy,
+  uint wavelengthCount,
+  device const float4 *spectralDensity,
+  device const float4 *weights
+) {
+  float3 sum = float3(0.0);
+  for (uint wavelength = 0u; wavelength < wavelengthCount; ++wavelength) {
+    sum += spektra_spectral_transmittance_pow(dot(densityCmy, spectralDensity[wavelength].xyz)) *
+      weights[wavelength].xyz;
+  }
+  return sum;
+}
+
+// Domains follow the reference: film from -grain density_min to the film curve
+// maximum, print from zero to the paper curve maximum. The host computes them.
+struct SpektraLutDomain {
+  float4 filmMin;
+  float4 filmMax;
+  float4 printMin;
+  float4 printMax;
+};
+
+static bool spektra_lut_sample(device const float4 *lut, float3 x, thread float3 &value) {
+  const float4 origin = lut[0];
+  const float3 scale = lut[1].xyz;
+  const float last = origin.w - 1.0;
+  const float3 u = (x - origin.xyz) * scale;
+  // Written so that NaN coordinates fail the test.
+  if (!all(u >= float3(0.0)) || !all(u <= float3(last))) {
+    return false;
+  }
+  const float3 cell = min(floor(u), float3(last - 1.0));
+  const float3 f = u - cell;
+  const uint n = uint(origin.w);
+  const uint3 c = uint3(cell);
+  device const float4 *p = lut + kSpektraLutHeader + (c.x * n + c.y) * n + c.z;
+  const float4 base = p[0];
+  if (!(base.w <= lut[1].w)) {
+    return false;
+  }
+  const uint sy = n;
+  const uint sx = n * n;
+  const float3 c00 = mix(base.xyz, p[1].xyz, f.z);
+  const float3 c01 = mix(p[sy].xyz, p[sy + 1u].xyz, f.z);
+  const float3 c10 = mix(p[sx].xyz, p[sx + 1u].xyz, f.z);
+  const float3 c11 = mix(p[sx + sy].xyz, p[sx + sy + 1u].xyz, f.z);
+  value = mix(mix(c00, c01, f.y), mix(c10, c11, f.y), f.x);
+  return true;
+}
+
+static void spektra_lut_write_header(device float4 *lut, float3 minimum, float3 maximum, uint n, float tolerance) {
+  lut[0] = float4(minimum, float(n));
+  lut[1] = float4(float(n - 1u) / max(maximum - minimum, float3(1.0e-6)), tolerance);
+}
+
+static float3 spektra_lut_cell_centre_mean(device const float4 *p, uint n) {
+  const uint sy = n;
+  const uint sx = n * n;
+  return 0.125 * (p[0].xyz + p[1].xyz + p[sy].xyz + p[sy + 1u].xyz +
+                  p[sx].xyz + p[sx + 1u].xyz + p[sx + sy].xyz + p[sx + sy + 1u].xyz);
+}
