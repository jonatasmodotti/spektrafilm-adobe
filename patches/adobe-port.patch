+  if getattr(resources, "_spektra_parity_data_redirect", False):
+    return
+  original_files = resources.files
+  prefix = "spektrafilm.data."
+
+  def files(package):
+    name = package if isinstance(package, str) else getattr(package, "__name__", "")
+    data_dir = os.environ.get("SPEKTRAFILM_DATA_DIR")
+    if data_dir and name.startswith(prefix):
+      candidate = Path(data_dir, *name[len(prefix):].split("."))
+      if candidate.is_dir():
+        return candidate
+    return original_files(package)
+
+  resources.files = files
+  resources._spektra_parity_data_redirect = True
+
