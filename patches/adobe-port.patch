+// gid.x = i * n + j, gid.y = k. Builds both LUTs from the exact integrals.
+kernel void spektrafilm_build_spectral_luts(
+  device float4 *enlargerLut [[buffer(0)]],
+  device float4 *scannerLut [[buffer(1)]],
+  constant SpektraKernelParams &params [[buffer(2)]],
+  constant uint &n [[buffer(3)]],
+  constant SpektraSpectralInfo &spectralInfo [[buffer(4)]],
+  constant SpektraLutDomain &domain [[buffer(5)]],
+  constant float2 &tolerance [[buffer(10)]],
+  device const float4 *filmSpectralDensity [[buffer(6)]],
+  device const float4 *filteredEnlargerResponse [[buffer(7)]],
+  device const float4 *paperSpectralDensity [[buffer(8)]],
+  device const float *scanProducts [[buffer(9)]],
+  uint2 gid [[thread_position_in_grid]]
