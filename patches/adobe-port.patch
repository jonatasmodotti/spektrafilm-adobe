+  const float3 rawExact = spektra_lut_spectral_sum(mix(domain.filmMin.xyz, domain.filmMax.xyz, t), count,
+    filmSpectralDensity, filteredEnlargerResponse);
+  const float3 rawLut = exp2(spektra_lut_cell_centre_mean(enlargerLut + index, n));
+  const float3 printExact = spektra_lut_print_density(rawExact, params, spectralInfo, paperCurveInfo,
+    paperLogExposure, paperDensityCurves, frameConstants);
+  const float3 printLut = spektra_lut_print_density(rawLut, params, spectralInfo, paperCurveInfo,
+    paperLogExposure, paperDensityCurves, frameConstants);
+  const float3 xyzExact = spektra_lut_spectral_sum(mix(domain.printMin.xyz, domain.printMax.xyz, t), count,
+    paperSpectralDensity, paperProducts);
+  const float3 xyzLut = exp2(spektra_lut_cell_centre_mean(scannerLut + index, n));
+  const float3 enlargerExact = spektra_lut_print_output(
+    spektra_lut_spectral_sum(printExact, count, paperSpectralDensity, paperProducts), inverseNormalization,
+    params, colorInfo, paperScanToOutputRgb, frameConstants, encodeLuts, transferKinds, encodeOutput);
+  const float3 enlargerApprox = spektra_lut_print_output(
+    spektra_lut_spectral_sum(printLut, count, paperSpectralDensity, paperProducts), inverseNormalization,
+    params, colorInfo, paperScanToOutputRgb, frameConstants, encodeLuts, transferKinds, encodeOutput);
+  const float3 scannerExact = spektra_lut_print_output(xyzExact, inverseNormalization,
+    params, colorInfo, paperScanToOutputRgb, frameConstants, encodeLuts, transferKinds, encodeOutput);
+  const float3 scannerApprox = spektra_lut_print_output(xyzLut, inverseNormalization,
+    params, colorInfo, paperScanToOutputRgb, frameConstants, encodeLuts, transferKinds, encodeOutput);
+  enlargerLut[index].w = spektra_max_abs_difference(enlargerExact, enlargerApprox);
+  scannerLut[index].w = spektra_max_abs_difference(scannerExact, scannerApprox);
+}
+
+// Print simulation (process 0) without bleach bypass or printer-density timing;
+// the host selects the exact kernel otherwise.
+static float4 spektra_final_from_film_density_lut_pixel(
+  float4 pixel,
+  constant SpektraKernelParams &params,
+  constant SpektraSpectralInfo &spectralInfo,
+  constant SpektraColorInfo &colorInfo,
+  device const uint *transferKinds,
+  constant SpektraCurveInfo &paperCurveInfo,
+  device const float *paperLogExposure,
+  device const float *paperDensityCurves,
+  device const float4 *filmSpectralDensity,
+  device const float4 *filteredEnlargerResponse,
+  device const float4 *paperSpectralDensity,
+  device const float *scanProducts,
+  device const float *scanToOutputRgbData,
+  device const float *encodeLuts,
+  constant SpektraFrameConstants &frameConstants,
+  uint encodeOutput,
+  device const float4 *enlargerLut,
+  device const float4 *scannerLut
+) {
+  const uint count = spectralInfo.filmWavelengthCount;
+  device const float *legacyScanProducts = scanProducts + count * 8u;
+  const float paperInverseNormalization = legacyScanProducts[count * 6u + 1u];
+  device const float *paperScanToOutputRgb = scanToOutputRgbData + colorInfo.colorSpaceCount * 9u;
+
+  float3 logRaw;
+  const float3 raw = spektra_lut_sample(enlargerLut, pixel.rgb, logRaw)
+    ? exp2(logRaw)
+    : spektra_lut_spectral_sum(pixel.rgb, count, filmSpectralDensity, filteredEnlargerResponse);
+  pixel.rgb = spektra_lut_print_density(raw, params, spectralInfo, paperCurveInfo, paperLogExposure, paperDensityCurves, frameConstants);
+
+  float3 logXyz;
+  device const float4 *paperProducts = (device const float4 *)scanProducts + count;
+  const float3 xyz = spektra_lut_sample(scannerLut, pixel.rgb, logXyz)
+    ? exp2(logXyz)
+    : spektra_lut_spectral_sum(pixel.rgb, count, paperSpectralDensity, paperProducts);
+  pixel.rgb = spektra_lut_print_output(xyz, paperInverseNormalization, params, colorInfo, paperScanToOutputRgb,
+    frameConstants, encodeLuts, transferKinds, encodeOutput);
+  return pixel;
+}
