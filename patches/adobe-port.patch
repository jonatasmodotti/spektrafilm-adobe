+// Adobe host frames (Adobe port): float32 or float16 RGBA/BGRA/ARGB, straight or
+// premultiplied alpha, with row padding and a start offset. Matches AdobeHostLayout in
+// SpektraMetalRenderer.h. Loads return straight RGBA; stores take straight RGB and
+// the alpha to write.
+struct SpektraAdobeHostLayout {
+  ulong rowComponents;
+  ulong offsetComponents;
+  uint width;
+  uint height;
+  uint order;
+  uint premultiplied;
+  uint halfPrecision;
+  uint reserved;
+};
+
+static float4 spektra_adobe_host_load(device const uchar *source, constant SpektraAdobeHostLayout &layout, uint2 p) {
+  const ulong i = layout.offsetComponents + ulong(p.y) * layout.rowComponents + ulong(p.x) * 4;
+  device const float *f = reinterpret_cast<device const float *>(source);
+  device const half *h = reinterpret_cast<device const half *>(source);
+  float4 v = layout.halfPrecision ? float4(h[i], h[i + 1], h[i + 2], h[i + 3]) : float4(f[i], f[i + 1], f[i + 2], f[i + 3]);
+  if (layout.order == 1u) {
+    v = v.bgra;
+  } else if (layout.order == 2u) {
+    v = v.yzwx;
+  }
+  if (layout.premultiplied) {
+    v.rgb = v.a > 0.0f ? precise::divide(v.rgb, float3(v.a)) : float3(0.0f);
+  }
+  return v;
+}
+
+static void spektra_adobe_host_store(device uchar *destination, constant SpektraAdobeHostLayout &layout, uint2 p, float4 v) {
+  if (layout.premultiplied) {
+    v.rgb = v.a > 0.0f ? v.rgb * v.a : float3(0.0f);
+  }
+  if (layout.order == 1u) {
+    v = v.bgra;
+  } else if (layout.order == 2u) {
+    v = v.wxyz;
+  }
+  const ulong i = layout.offsetComponents + ulong(p.y) * layout.rowComponents + ulong(p.x) * 4;
+  if (layout.halfPrecision) {
+    device half *h = reinterpret_cast<device half *>(destination);
+    h[i] = half(v.x);
+    h[i + 1] = half(v.y);
+    h[i + 2] = half(v.z);
+    h[i + 3] = half(v.w);
+  } else {
+    device float *f = reinterpret_cast<device float *>(destination);
+    f[i] = v.x;
+    f[i + 1] = v.y;
+    f[i + 2] = v.z;
+    f[i + 3] = v.w;
+  }
+}
+
+kernel void spektrafilm_adobe_host_unpack(
+  device const uchar *source [[buffer(0)]],
+  device float4 *rgba [[buffer(1)]],
+  constant SpektraAdobeHostLayout &layout [[buffer(2)]],
+  uint2 gid [[thread_position_in_grid]]
+) {
+  if (gid.x >= layout.width || gid.y >= layout.height) {
+    return;
+  }
+  rgba[gid.y * layout.width + gid.x] = spektra_adobe_host_load(source, layout, gid);
+}
+
+// Writes rendered RGB with the source alpha, as the host expects alpha untouched.
+kernel void spektrafilm_adobe_host_pack(
+  device const float4 *rendered [[buffer(0)]],
+  device const uchar *hostSource [[buffer(1)]],
+  device uchar *destination [[buffer(2)]],
+  constant SpektraAdobeHostLayout &sourceLayout [[buffer(3)]],
+  constant SpektraAdobeHostLayout &destinationLayout [[buffer(4)]],
+  uint2 gid [[thread_position_in_grid]]
+) {
+  if (gid.x >= destinationLayout.width || gid.y >= destinationLayout.height) {
+    return;
+  }
+  const float alpha = spektra_adobe_host_load(hostSource, sourceLayout, gid).a;
+  spektra_adobe_host_store(destination, destinationLayout, gid,
+    float4(rendered[gid.y * destinationLayout.width + gid.x].rgb, alpha));
+}
