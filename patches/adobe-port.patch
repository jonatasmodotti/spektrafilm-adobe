+def install_python_data_redirect() -> None:
+  """Serve spektrafilm.data.* from SPEKTRAFILM_DATA_DIR, the data the Metal build uses.
+
+  The published Python package loads profiles, neutral print filters and LUTs
+  from its own package directory. Without this, the reference silently uses
+  another data revision: the package's neutral print filters alone shift
+  print_log_raw by up to 0.025 log10 per channel. Subpackages missing from the
+  data directory still load from the package.
